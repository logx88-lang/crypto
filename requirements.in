# requirements.in — 패키지 후보(설계 단계 초안)
#
# 규칙: 여기 나열된 후보는 "Windows + Python 3.10~3.12 + 순수 pip wheel 오프라인 설치 가능"을
# 전제로 한다. 버전 고정(==)은 wheelhouse 구성 단계에서 `pip download` 실측 후 확정한다.
# 아직 애플리케이션 코드가 없으므로 이 파일은 후보 목록이며 확정 매니페스트가 아니다.

# --- UI ---
streamlit            # 단일 호스트 다중 사용자 웹 UI (0.0.0.0:8501)

# --- 벡터 DB / 검색 ---
chromadb             # 벡터 저장/검색 (onnxruntime 등 네이티브 의존성 wheel 동반 확인 필요)
kiwipiepy            # 한국어 형태소 분석 (BM25 토큰화) — Windows wheel 제공
bm25s                # BM25 sparse 검색 (순수 파이썬) ; 대안 rank_bm25

# --- 리랭커 (MVP 포함 — 사용자 요청) ---
sentence-transformers  # bge-reranker-v2-m3 CrossEncoder 로더
transformers           # sentence-transformers 의존 (순수 wheel)
torch                  # 리랭커 백엔드. Windows CPU wheel(대용량). 상향 시 CUDA 빌드로 교체
#   모델 가중치(bge-reranker-v2-m3)는 USB로 반입 (pip 대상 아님)

# --- LLM / 임베딩 런타임 ---
ollama               # Ollama 파이썬 클라이언트 (엔진·모델은 배포 PC 기설치)

# --- 문서 파서 ---
openpyxl             # xlsx
python-docx          # docx
python-pptx          # pptx (Pillow 동반)
pdfplumber           # pdf (표+텍스트, 순수 파이썬/MIT, pdfminer.six 동반) — 프로토콜 명세 주 포맷
charset-normalizer   # txt 인코딩 자동 판별 (EUC-KR/CP949/UTF-8)

# --- OCR (Phase 3, 구현 완료 — 이미지·스캔PDF 인제스천) ---
paddleocr            # 3.7.0 검증. 3.x predict() API, rec_texts 추출
paddlepaddle         # 3.3.1 검증(CPU). Windows wheel 있음(대용량). 모델 가중치는 USB 반입
#   ⚠️ 일부 CPU서 oneDNN/PIR 런타임 버그 → 코드가 enable_mkldnn=False 로 회피(실측)
#   opencv/shapely/pyclipper/scikit-image/lmdb/rapidfuzz 등 동반(전부 win wheel 확인)
