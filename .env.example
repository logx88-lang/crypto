# Bot Configuration
MODE=TEST  # TEST or LIVE

# ============================================================
# Exchange API Keys
# ============================================================

# GRVT (uses official Python SDK: grvt-pysdk)
# Get API keys from: https://app.grvt.io (testnet) or https://trade.grvt.io (mainnet)
GRVT_API_KEY=
GRVT_PRIVATE_KEY=
GRVT_TRADING_ACCOUNT_ID=

# Lighter (uses official Python SDK: lighter-v1-python)
# Get API keys from: https://lighter.xyz
# Note: Requires Web3 provider URL (e.g., Alchemy, Infura)
LIGHTER_API_KEY=
LIGHTER_PRIVATE_KEY=
LIGHTER_WEB3_PROVIDER_URL=

# Variational (REST API)
# Note: API is currently in pre-launch phase
# Check: https://docs.variational.io/technical-documentation/api
VARIATIONAL_API_KEY=
VARIATIONAL_API_SECRET=

# Pacifica (REST API)
# Get API keys from: https://pacifica.fi
# Solana-based perpetual DEX
PACIFICA_API_KEY=
PACIFICA_API_SECRET=

# ============================================================
# Trading Parameters
# ============================================================
DEFAULT_LEVERAGE=5
MAX_POSITION_SIZE=0.001
SPREAD_BPS=10
DRIFT_THRESHOLD=5
ORDER_REFRESH_INTERVAL=60

# ============================================================
# Risk Management
# ============================================================
AUTO_CLOSE_POSITION=false
MAX_DAILY_LOSS=100
STOP_LOSS_PERCENT=5

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=bot.log
